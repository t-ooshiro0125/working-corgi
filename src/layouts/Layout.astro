---
import "../styles/index.scss";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const baseUrl = import.meta.env.BASE_URL;

const navigationItems = [
  { label: "Home", href: baseUrl },
  { label: "About", href: `${baseUrl}about/` },
  { label: "Works", href: `${baseUrl}works/` },
  { label: "Notes", href: `${baseUrl}notes/` },
];

const {
  title = "Working Corgi",
  description = "ACorgi0125 の個人サイトです。",
  ogImage = "/og-image.png",
  ogImageAlt = "Working Corgi のロゴと、キャップをかぶったコーギーのイラスト",
} = Astro.props as Props;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const navigation = navigationItems.map((item) => {
  const path =
    new URL(item.href, Astro.url).pathname.replace(/\/+$/, "") || "/";

  return {
    ...item,
    isCurrent:
      currentPath === path ||
      (path !== "/" && currentPath.startsWith(`${path}/`)),
  };
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link
      rel="icon"
      type="image/png"
      href={`${baseUrl}corgi-favicon-black.png`}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href={`${baseUrl}corgi-favicon-white.png`}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Working Corgi" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <div class="site">
      <img
        class="site__paw-prints"
        src={`${baseUrl}corgi-paw-prints.svg`}
        alt=""
      />

      <header class="site-header">
        <div class="site-header__inner">
          <a
            class="site-header__brand"
            href={baseUrl}
            aria-label="Working Corgi"
          >
            <img
              class="site-header__logo"
              src={`${baseUrl}corgi-favicon-black.webp`}
              alt=""
              width="512"
              height="512"
            />
            <span class="site-header__name">Working Corgi</span>
          </a>
          <nav class="site-header__nav" aria-label="メインナビゲーション">
            {
              navigation.map(({ label, href, isCurrent }) => (
                <a
                  class="site-header__link"
                  href={href}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  {label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner">
          <p class="site-footer__copyright">
            © {new Date().getFullYear()} Working Corgi
          </p>
        </div>
      </footer>
    </div>
  </body>

  <style lang="scss">
    .site {
      position: relative;
      display: grid;
      grid-template-rows: auto 1fr auto;
      min-height: 100svh;
    }

    .site__paw-prints {
      position: absolute;
      right: clamp(1rem, 4vw, 4rem);
      bottom: clamp(1rem, 4vw, 4rem);
      z-index: 0;
      width: clamp(8rem, 20vw, 16rem);
      opacity: 0.06;
      pointer-events: none;
    }

    .site-header {
      border-bottom: 1px solid var(--color-border);
      position: relative;
      z-index: 1;
    }

    .site-header__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      width: 100%;
      max-width: var(--content-width);
      margin-inline: auto;
      padding: var(--space-lg) var(--content-padding);
    }

    .site-header__brand {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      color: var(--color-text);
    }

    .site-header__logo {
      width: 1.75rem;
      height: 1.75rem;
    }

    .site-header__name {
      white-space: nowrap;
      color: var(--color-text);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .site-header__nav {
      display: flex;
      gap: var(--space-sm);
    }

    .site-header__link {
      display: inline-flex;
      align-items: center;
      min-height: 2.25rem;
      padding-inline: var(--space-sm);
      color: var(--color-text-muted);
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      font-weight: 700;

      &:hover {
        color: var(--color-text);
        background: var(--color-accent-soft);
      }
    }

    .site-header__link[aria-current="page"] {
      color: var(--color-text);
      background: var(--color-accent-soft);
    }

    .site-main {
      width: 100%;
      max-width: var(--content-width);
      margin-inline: auto;
      padding: var(--space-2xl) var(--content-padding);
      position: relative;
      z-index: 1;
    }

    .site-footer {
      border-top: 1px solid var(--color-border);
      position: relative;
      z-index: 1;
    }

    .site-footer__inner {
      width: 100%;
      max-width: var(--content-width);
      margin-inline: auto;
      padding: var(--space-lg) var(--content-padding);
    }

    .site-footer__copyright {
      color: var(--color-text-muted);
      font-size: 0.875rem;
    }

    @media (max-width: 35rem) {
      .site-header__inner {
        gap: var(--space-sm);
        padding-inline: var(--space-md);
      }

      .site-header__nav {
        gap: 0;
      }

      .site-header__link {
        padding-inline: var(--space-xs);
      }
    }

    @media (max-width: 30rem) {
      .site-header__name {
        display: none;
      }
    }
  </style>
</html>
