---
import type { ChangelogEntry } from "../domain/changelog";
import { formatChangelogDate, getChangelogLinkHref } from "../utils/changelog";

interface Props {
  entries: readonly ChangelogEntry[];
  variant?: "full" | "compact";
}

const { entries, variant = "full" } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
const isCompact = variant === "compact";
---

<ol
  class:list={["changelog-list", { "changelog-list--compact": isCompact }]}
  role="list"
>
  {
    entries.map((entry) => (
      <li class="changelog-list__item">
        <article class="changelog-list__article">
          <time class="changelog-list__date" datetime={entry.date}>
            {formatChangelogDate(entry.date)}
          </time>
          <h3 class="changelog-list__title">
            {entry.link ? (
              <a
                class="changelog-list__link"
                href={getChangelogLinkHref(entry.link, baseUrl)}
              >
                {entry.title}
              </a>
            ) : (
              entry.title
            )}
          </h3>
          {!isCompact && (
            <p class="changelog-list__description">{entry.description}</p>
          )}
        </article>
      </li>
    ))
  }
</ol>

<style lang="scss">
  .changelog-list {
    display: grid;
    gap: var(--space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .changelog-list__item {
    position: relative;
    padding-left: var(--space-xl);

    &::before {
      position: absolute;
      top: 0.5rem;
      left: 0;
      width: 0.75rem;
      height: 0.75rem;
      content: "";
      background: var(--color-mustard);
      border: 0.2rem solid var(--color-background);
      border-radius: 50%;
      box-shadow: 0 0 0 1px var(--color-mustard);
    }

    &:not(:last-child)::after {
      position: absolute;
      top: 1.5rem;
      bottom: calc(-1 * var(--space-md) - 0.5rem);
      left: 0.35rem;
      width: 1px;
      content: "";
      background: var(--color-border);
    }
  }

  .changelog-list__article {
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  .changelog-list__date {
    display: block;
    margin-bottom: var(--space-xs);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent-strong);
  }

  .changelog-list__title {
    margin: 0;
    font-size: clamp(1.125rem, 3vw, 1.375rem);
  }

  .changelog-list__link {
    color: var(--color-link);
    text-decoration-line: underline;
    text-decoration-thickness: 0.08em;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.16em;
  }

  .changelog-list__description {
    margin: var(--space-sm) 0 0;
  }

  .changelog-list--compact {
    --changelog-list-text-size: 0.875rem;

    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .changelog-list--compact .changelog-list__item {
    padding-left: var(--space-lg);

    &::before {
      top: 1.25rem;
      left: 0.25rem;
      z-index: 1;
      width: 0.625rem;
      height: 0.625rem;
      border: 0.125rem solid var(--color-surface);
    }

    &:not(:last-child)::after {
      top: 1.5625rem;
      bottom: -1.5625rem;
      left: 0.5625rem;
    }
  }

  .changelog-list--compact .changelog-list__article {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-sm) 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: none;
  }

  .changelog-list--compact .changelog-list__date,
  .changelog-list--compact .changelog-list__title {
    font-size: var(--changelog-list-text-size);
  }

  .changelog-list--compact .changelog-list__date {
    margin-bottom: 0;
    font-variant-numeric: tabular-nums;
  }

  .changelog-list--compact .changelog-list__title {
    font-weight: 400;
  }

  .changelog-list--compact .changelog-list__link {
    color: var(--color-text);

    &:is(:hover, :focus-visible) {
      color: var(--color-link);
    }
  }

  @media (width <= 40rem) {
    .changelog-list__item {
      padding-left: var(--space-lg);
    }

    .changelog-list__article {
      padding: var(--space-md);
    }

    .changelog-list--compact .changelog-list__article {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
      padding: var(--space-sm) 0;
    }
  }
</style>
