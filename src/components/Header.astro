---
interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props as Props;

const navigationItems = [
  { label: "Home", href: baseUrl },
  { label: "About", href: `${baseUrl}about/` },
  { label: "Works", href: `${baseUrl}works/` },
  { label: "Notes", href: `${baseUrl}notes/` },
  { label: "Contact", href: `${baseUrl}contact/` },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const navigation = navigationItems.map((item) => {
  const path =
    new URL(item.href, Astro.url).pathname.replace(/\/+$/, "") || "/";

  return {
    ...item,
    isCurrent:
      currentPath === path ||
      (path !== "/" && currentPath.startsWith(`${path}/`)),
  };
});
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={baseUrl} aria-label="Working Corgi">
      <img
        class="site-header__logo"
        src={`${baseUrl}corgi-mark.webp`}
        alt=""
        width="56"
        height="56"
      />
      <span class="site-header__name">Working Corgi</span>
    </a>
    <button
      class="site-header__menu-button"
      type="button"
      aria-controls="site-navigation"
      aria-expanded="false"
      aria-label="ナビゲーションを開く"
    >
      <span class="site-header__menu-icon" aria-hidden="true"></span>
    </button>
    <nav
      id="site-navigation"
      class="site-header__nav"
      aria-label="メインナビゲーション"
    >
      <div class="site-header__nav-list">
        {
          navigation.map(({ label, href, isCurrent }) => (
            <a
              class="site-header__link"
              href={href}
              aria-current={isCurrent ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const menuLabels = {
    closed: "ナビゲーションを開く",
    open: "ナビゲーションを閉じる",
  };

  const initializeHeaderNavigation = () => {
    const header = document.querySelector<HTMLElement>(".site-header");

    if (!header) {
      return;
    }

    const brandLink = header.querySelector<HTMLAnchorElement>(
      ".site-header__brand",
    );
    const menuButton = document.querySelector<HTMLButtonElement>(
      ".site-header__menu-button",
    );
    const navigation = document.querySelector<HTMLElement>("#site-navigation");

    if (!brandLink || !menuButton || !navigation) {
      return;
    }

    const mobileMediaQuery = window.matchMedia("(width <= 40rem)");

    const setMenuButtonAccessibility = (isOpen: boolean) => {
      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.setAttribute(
        "aria-label",
        isOpen ? menuLabels.open : menuLabels.closed,
      );
    };

    // モバイルメニューの開閉状態を見た目とアクセシビリティ属性に反映する。
    const setMobileNavigationState = (isOpen: boolean) => {
      navigation.classList.toggle("site-header__nav--open", isOpen);
      menuButton.classList.toggle("site-header__menu-button--open", isOpen);
      navigation.inert = !isOpen;
      navigation.setAttribute("aria-hidden", String(!isOpen));
      setMenuButtonAccessibility(isOpen);
    };

    // 閉じる前に、ナビゲーション内のフォーカスをメニューボタンへ退避する。
    const closeMobileNavigation = () => {
      if (navigation.contains(document.activeElement)) {
        menuButton.focus();
      }

      setMobileNavigationState(false);
    };

    // デスクトップではナビゲーションを常に操作可能な状態に戻す。
    const setDesktopNavigationState = () => {
      if (document.activeElement === menuButton) {
        brandLink.focus();
      }
      navigation.classList.remove("site-header__nav--open");
      menuButton.classList.remove("site-header__menu-button--open");
      navigation.inert = false;
      navigation.removeAttribute("aria-hidden");
      setMenuButtonAccessibility(false);
    };

    // 表示幅に応じてナビゲーションの状態を同期する。
    const syncNavigationWithViewport = () => {
      if (mobileMediaQuery.matches) {
        closeMobileNavigation();
      } else {
        setDesktopNavigationState();
      }
    };

    syncNavigationWithViewport();

    // モバイルではボタンで開閉し、Escape キーで閉じる。
    menuButton.addEventListener("click", () => {
      if (!mobileMediaQuery.matches) {
        return;
      }

      const isOpen = navigation.classList.contains("site-header__nav--open");

      if (isOpen) {
        closeMobileNavigation();
      } else {
        setMobileNavigationState(true);
      }
    });

    header.addEventListener("keydown", (event) => {
      const isOpen = navigation.classList.contains("site-header__nav--open");

      if (event.key !== "Escape" || !mobileMediaQuery.matches || !isOpen) {
        return;
      }

      closeMobileNavigation();
    });

    mobileMediaQuery.addEventListener("change", syncNavigationWithViewport);
  };

  initializeHeaderNavigation();
</script>

<style lang="scss">
  .site-header {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--content-width);
    padding-block: var(--space-lg);
    padding-inline: clamp(var(--space-md), 3vw, var(--content-padding));
    margin-inline: auto;
  }

  .site-header__brand {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    color: var(--color-text);
  }

  .site-header__logo {
    width: 1.75rem;
    height: 1.75rem;
  }

  .site-header__name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .site-header__menu-button {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--color-text);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);

    &:hover {
      background: var(--color-accent-soft);
    }
  }

  .site-header__menu-icon {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 0.125rem;
    background: currentcolor;
    transition: background-color 160ms ease;

    &::before,
    &::after {
      position: absolute;
      left: 0;
      width: 100%;
      height: 100%;
      content: "";
      background: currentcolor;
      transition: transform 160ms ease;
    }

    &::before {
      transform: translateY(-0.375rem);
    }

    &::after {
      transform: translateY(0.375rem);
    }
  }

  .site-header__nav {
    display: flex;
    gap: clamp(var(--space-2xs), 1.5vw, var(--space-sm));
  }

  .site-header__nav-list {
    display: contents;
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: clamp(var(--space-2xs), 1.5vw, var(--space-sm));
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);

    &:is(:hover, [aria-current="page"]) {
      color: var(--color-text);
      background: var(--color-accent-soft);
    }
  }

  @media (width <= 40rem) {
    .site-header__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 var(--space-sm);
      padding-block: 1.25rem;
    }

    .site-header__nav {
      flex-direction: column;
      grid-column: 1 / -1;
      width: 100%;
    }

    .site-header__nav-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      min-height: 0;
      overflow: hidden;
    }

    .site-header__link {
      width: 100%;
      padding-inline: var(--space-sm);
    }

    .site-header__menu-button--open .site-header__menu-icon {
      background: transparent;

      &::before {
        transform: translateY(0) rotate(45deg);
      }

      &::after {
        transform: translateY(0) rotate(-45deg);
      }
    }

    :global(html.js) {
      .site-header__nav {
        display: grid;
        visibility: hidden;
        grid-template-rows: 0fr;
        gap: 0;
        overflow: hidden;
        pointer-events: none;
        opacity: 0;
        transform: translateY(-0.5rem);
        transition:
          grid-template-rows 220ms ease,
          opacity 160ms ease,
          transform 220ms ease,
          visibility 220ms;
      }

      .site-header__nav--open {
        visibility: visible;
        grid-template-rows: 1fr;
        pointer-events: auto;
        opacity: 1;
        transform: translateY(0);
      }

      .site-header__nav--open .site-header__nav-list {
        padding-top: var(--space-sm);
      }

      .site-header__menu-button {
        display: inline-flex;
      }
    }
  }
</style>
