---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
---

<Layout
  title={`Works | ${site.name}`}
  description="ACorgi0125 が制作している個人開発アプリと個人サイトを紹介します。"
>
  <div class="works">
    <section class="works__hero">
      <p class="page__eyebrow">MY WORKS</p>
      <h1 class="works__title page__title">Works</h1>
      <p class="works__lead page__lead">
        個人で制作・運用しているものを、公開できる範囲で紹介します。
      </p>
    </section>

    <section class="works__projects" aria-labelledby="works-projects-title">
      <h2 id="works-projects-title" class="works__heading">制作物</h2>

      <div class="works__project-list">
        <article class="works__project">
          <img
            class="works__project-image"
            src={`${import.meta.env.BASE_URL}working-corgi-cover.webp`}
            alt="ノートパソコンで個人サイトを作るコーギーのイラスト"
            width="1672"
            height="941"
          />
          <div class="works__project-content">
            <p class="works__project-status works__project-status--published">
              公開中
            </p>
            <h3 class="works__project-title">Working Corgi</h3>
            <p class="works__project-description">
              自己紹介、制作物、技術記事を公開する個人サイトです。
            </p>

            <ul class="works__project-links" role="list">
              <li>
                <a
                  class="button button--primary"
                  href="https://workingcorgi.com"
                  target="_blank"
                  rel="noopener"
                >
                  サイトを見る
                </a>
              </li>
              <li>
                <a
                  class="button button--secondary"
                  href="https://github.com/t-ooshiro0125/workingcorgi"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub
                </a>
              </li>
            </ul>
          </div>
        </article>

        <article class="works__project">
          <img
            class="works__project-image"
            src={`${import.meta.env.BASE_URL}companion-app-cover.webp`}
            alt="コーギーと相手のキャラクターが会話するイラスト"
            width="1672"
            height="941"
          />
          <div class="works__project-content">
            <p class="works__project-status works__project-status--in-progress">
              開発中
            </p>
            <h3 class="works__project-title">Companion App</h3>
            <p class="works__project-description">
              キャラクターと会話する個人開発アプリです。公開できる内容を少しずつ整えています。
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Layout>

<style lang="scss">
  .works {
    display: grid;
    gap: var(--space-2xl);
  }

  .works__hero {
    max-width: 42rem;
    padding-block: var(--space-2xl);
  }

  .works__heading {
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
  }

  .works__project-list {
    display: grid;
    gap: var(--space-md);
  }

  .works__project {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 0.25rem solid var(--color-mustard);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  .works__project-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .works__project-content {
    min-width: 0;
  }

  .works__project-status {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2xs) var(--space-xs);
    margin-bottom: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }

  .works__project-status--published {
    background: var(--color-accent-soft);
  }

  .works__project-status--in-progress {
    background: var(--color-terracotta-soft);
  }

  .works__project-title {
    font-size: 1.25rem;
  }

  .works__project-description {
    max-width: 42rem;
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
  }

  .works__project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0;
    margin-top: var(--space-lg);
  }

  @media (width <= 40rem) {
    .works__project {
      grid-template-columns: 1fr;
    }

    .works__project-image {
      justify-self: center;
      max-width: 28rem;
    }
  }
</style>
